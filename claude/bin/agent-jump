#!/bin/bash
# Fast path: straight to the most urgent agent, no menu. Bound to prefix+G.
set -uo pipefail
row=$("$HOME/.claude/bin/agent-state" | head -1)
[ -n "$row" ] || { tmux display-message "no live agents"; exit 0; }
exec "$HOME/.claude/bin/agent-goto" "$(printf '%s\n' "$row" | cut -f6)" \
                                    "$(printf '%s\n' "$row" | cut -f7)"
